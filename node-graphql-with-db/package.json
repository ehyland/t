{
  "type": "module",
  "scripts": {
    "dev": "pnpm run '/^(dev:.*)$/'",
    "dev:app": "vite",
    "dev:server": "ENV=dev tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "build": "pnpm run '/^(build:.*)$/'",
    "build:app": "vite build",
    "build:server": "vite build --config vitest.server.config.ts",
    "start:dev": "ENV=dev node dist/index.js",
    "studio": "ENV=dev drizzle-kit studio",
    "gen": "graphql-codegen --config graphql.config.ts",
    "gen:watch": "graphql-codegen --config graphql.config.ts --watch",
    "db:reset": "rm -rf migrations && ENV=dev drizzle-kit generate",
    "db:generate-migration": "ENV=dev drizzle-kit generate",
    "db:run-migrations": "ENV=dev drizzle-kit migrate",
    "typecheck": "pnpm tsc -b --noEmit",
    "lint": "eslint",
    "format": "prettier --check ./",
    "format:fix": "prettier --write ./",
    "test": "vitest",
    "test:ci": "CI=true vitest",
    "check": "pnpm run '/^(typecheck|lint|format|test:ci)$/'"
  },
  "dependencies": {
    "@graphql-yoga/plugin-disable-introspection": "^2.17.0",
    "@libsql/client": "^0.15.15",
    "@mantine/core": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@tabler/icons-react": "^3.35.0",
    "close-with-grace": "^2.3.0",
    "cookie": "^1.0.2",
    "cookie-signature": "^1.2.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.0",
    "emittery": "^1.2.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.1",
    "graphql-tag": "^2.12.6",
    "graphql-yoga": "^5.16.0",
    "ix": "^7.0.0",
    "ky": "^1.13.0",
    "morgan": "^1.10.1",
    "remeda": "^2.32.0",
    "tiny-invariant": "^1.3.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/introspection": "5.0.0",
    "@graphql-codegen/plugin-helpers": "^6.0.0",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-document-nodes": "5.0.2",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-resolvers": "5.1.0",
    "@graphql-codegen/typescript-urql": "^4.0.1",
    "@graphql-codegen/urql-introspection": "^3.0.1",
    "@parcel/watcher": "^2.5.1",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@urql/exchange-graphcache": "^8.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.6",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.2",
    "globals": "^16.5.0",
    "graphql-config": "^5.1.5",
    "graphql-sse": "^2.6.0",
    "msw": "^2.11.6",
    "outdent": "^0.8.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supertest-fetch": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "undici": "^7.16.0",
    "urql": "^5.0.1",
    "utility-types": "^3.11.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@latest"
    }
  }
}
