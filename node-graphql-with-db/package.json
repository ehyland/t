{
  "type": "module",
  "scripts": {
    "dev": "ENV=dev tsx watch src/server/index.ts",
    "start:dev": "ENV=dev node dist/index.js",
    "studio": "ENV=dev drizzle-kit studio",
    "build": "tsup-node",
    "gen": "pnpm run '/^(graphql:gen:.*)$/'",
    "gen:watch": "pnpm run '/^(graphql:watch:.*)$/'",
    "graphql:gen:api": "graphql-codegen --config graphql.config.ts --project api",
    "graphql:gen:app": "graphql-codegen --config graphql.config.ts --project app",
    "graphql:gen:test-client": "graphql-codegen --config graphql.config.ts --project test-client",
    "graphql:watch:api": "graphql-codegen --config graphql.config.ts --project api --watch",
    "graphql:watch:app": "graphql-codegen --config graphql.config.ts --project app --watch",
    "graphql:watch:test-client": "graphql-codegen --config graphql.config.ts --project test-client --watch",
    "db:reset": "rm -rf migrations && ENV=dev drizzle-kit generate",
    "db:generate-migration": "ENV=dev drizzle-kit generate",
    "db:run-migrations": "ENV=dev drizzle-kit migrate",
    "typecheck": "tsc",
    "lint": "eslint",
    "format": "prettier --check ./",
    "format:fix": "prettier --write ./",
    "test": "vitest",
    "test:ci": "CI=true vitest",
    "check": "pnpm run '/^(typecheck|lint|format|test:ci)$/'"
  },
  "dependencies": {
    "@graphql-yoga/plugin-disable-introspection": "^2.17.0",
    "@libsql/client": "^0.15.15",
    "close-with-grace": "^2.3.0",
    "cookie": "^1.0.2",
    "cookie-signature": "^1.2.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "emittery": "^1.2.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "graphql-tag": "^2.12.6",
    "graphql-yoga": "^5.16.0",
    "ix": "^7.0.0",
    "ky": "^1.11.0",
    "morgan": "^1.10.1",
    "remeda": "^2.32.0",
    "tiny-invariant": "^1.3.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/introspection": "5.0.0",
    "@graphql-codegen/typescript": "5.0.1",
    "@graphql-codegen/typescript-document-nodes": "5.0.1",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^5.0.1",
    "@graphql-codegen/typescript-resolvers": "5.0.1",
    "@graphql-codegen/typescript-urql": "^4.0.1",
    "@parcel/watcher": "^2.5.1",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.6.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.5",
    "env-cmd": "^11.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.2",
    "globals": "^16.4.0",
    "graphql-config": "^5.1.5",
    "graphql-sse": "^2.5.4",
    "msw": "^2.11.3",
    "outdent": "^0.8.0",
    "prettier": "^3.6.2",
    "supertest-fetch": "^2.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "undici": "^7.16.0",
    "utility-types": "^3.11.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.0"
}
